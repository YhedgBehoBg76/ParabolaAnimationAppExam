<Window x:Class="ParabolaAnimationApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParabolaAnimationApp"
        mc:Ignorable="d"
        Title="Параболическая анимация" Height="450" Width="450"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Canvas x:Name="AnimationCanvas" Background="White"
                Width="400" Height="400" Margin="10">
            <Ellipse Width="20" Height="20" Fill="Red"
                     Canvas.Left="{Binding ObjectX}"
                     Canvas.Top="{Binding ObjectY}"></Ellipse>
        </Canvas>
        
        <Button Content="Старт" HorizontalAlignment="Center"
                VerticalAlignment="Bottom" Margin="0,0,0,20"
                Width="80" Height="30"
                Command="{Binding StartCommand}"></Button>
    </Grid>
</Window>
